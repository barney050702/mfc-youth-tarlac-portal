rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is a Super Admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'reyesbarney38@gmail.com';
    }

    // Function to check if the user is a Chapter Head
    function isChapterHead() {
      return request.auth != null && request.auth.token.email == 'chapter@mfcyouthtarlac.com';
    }

    // Members collection
    match /members/{memberId} {
      // Anyone can read their own document by ID (needed for Member Portal login)
      allow get: if true;
      // Only Super Admin and Chapter Head can list all members
      allow list: if isSuperAdmin() || isChapterHead();
      
      // Only Super Admin and Chapter Head can create, but only Super Admin can update/delete
      allow create: if isSuperAdmin() || isChapterHead();
      allow update, delete: if isSuperAdmin();
    }

    // Activities collection
    match /activities/{activityId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Attendance collection
    match /attendance/{docId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isChapterHead();
    }
    
    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Roles collection (Security Enhancement)
    match /roles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isSuperAdmin();
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
