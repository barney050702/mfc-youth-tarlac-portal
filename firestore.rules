rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is a Super Admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'reyesbarney38@gmail.com';
    }

    // Function to check if the user is a Chapter Head
    function isChapterHead() {
      return request.auth != null && request.auth.token.email == 'chapter@mfcyouthtarlac.com';
    }

    // Members collection
    match /members/{memberId} {
      // Anyone can read (needed for Member Portal self-service)
      allow read: if true;
      
      // Only Super Admin can write (create, update, delete)
      allow create: if isSuperAdmin() || isChapterHead();
      allow update, delete: if isSuperAdmin();
    }

    // Activities collection
    match /activities/{activityId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Attendance collection
    match /attendance/{docId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isChapterHead();
    }
    
    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
